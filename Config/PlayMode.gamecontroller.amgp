<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.5.1">
    <!--The SDL name for a joystick is included for informational purposes only.-->
    <sdlname>Xbox One Controller</sdlname>
    <!--The Unique ID for a joystick is included for informational purposes only.-->
    <uniqueID>0300938d5e040000ff020000000072001118767</uniqueID>
    <stickAxisAssociation index="1" xAxis="1" yAxis="2"/>
    <stickAxisAssociation index="2" xAxis="3" yAxis="4"/>
    <vdpadButtonAssociations index="1">
        <vdpadButtonAssociation axis="0" button="12" direction="1"/>
        <vdpadButtonAssociation axis="0" button="13" direction="4"/>
        <vdpadButtonAssociation axis="0" button="14" direction="8"/>
        <vdpadButtonAssociation axis="0" button="15" direction="2"/>
    </vdpadButtonAssociations>
    <names>
        <controlstickname index="1">Stick 1</controlstickname>
        <controlstickname index="2">Stick 2</controlstickname>
    </names>
    <sets>
        <set index="1">
            <trigger index="5">
                <throttle>positivehalf</throttle>
            </trigger>
            <trigger index="6">
                <throttle>positivehalf</throttle>
            </trigger>
            <button index="6">
                <slots>
                    <slot>
                        <path>C:/Scripts/Controller/sound_on.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>1</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
        </set>
        <set index="2">
            <dpad index="1">
                <dpadbutton index="4">
                    <slots>
                        <slot>
                            <code>0x1000022</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>0x1000021</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>0x1000020</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>0x42</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>100</code>
                            <mode>pause</mode>
                        </slot>
                        <slot>
                            <path>C:/Scripts/Controller/sound_off.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>0</code>
                            <mode>setchange</mode>
                        </slot>
                    </slots>
                </dpadbutton>
                <dpadbutton index="8">
                    <slots>
                        <slot>
                            <path>C:/Scripts/Controller/reboot.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>100</code>
                            <mode>pause</mode>
                        </slot>
                        <slot>
                            <path>C:/Scripts/Controller/sound_off.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>0</code>
                            <mode>setchange</mode>
                        </slot>
                    </slots>
                </dpadbutton>
                <dpadbutton index="1">
                    <slots>
                        <slot>
                            <path>C:/Scripts/Controller/task_killer.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>100</code>
                            <mode>pause</mode>
                        </slot>
                        <slot>
                            <path>C:/Scripts/Controller/sound_off.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>0</code>
                            <mode>setchange</mode>
                        </slot>
                    </slots>
                </dpadbutton>
                <dpadbutton index="2">
                    <slots>
                        <slot>
                            <code>0x1000023</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>0x1000004</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>100</code>
                            <mode>pause</mode>
                        </slot>
                        <slot>
                            <path>C:/Scripts/Controller/sound_off.exe</path>
                            <mode>execute</mode>
                        </slot>
                        <slot>
                            <code>0</code>
                            <mode>setchange</mode>
                        </slot>
                    </slots>
                </dpadbutton>
            </dpad>
            <trigger index="5">
                <throttle>positivehalf</throttle>
            </trigger>
            <trigger index="6">
                <throttle>positivehalf</throttle>
            </trigger>
            <button index="1">
                <slots>
                    <slot>
                        <path>C:/Scripts/Controller/Return to Gaming Mode.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>100</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <path>C:/Scripts/Controller/sound_off.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
            <button index="2">
                <slots>
                    <slot>
                        <code>0x1000023</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>0x1000033</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>100</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <path>C:/Scripts/Controller/sound_off.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
            <button index="3">
                <slots>
                    <slot>
                        <code>0x1000023</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>0x1000001</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>100</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <path>C:/Scripts/Controller/sound_off.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
            <button index="4">
                <slots>
                    <slot>
                        <code>0x1000021</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>0x1000023</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>0x53</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>100</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <path>C:/Scripts/Controller/sound_off.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
            <button index="6">
                <slots>
                    <slot>
                        <path>C:/Scripts/Controller/sound_off.exe</path>
                        <mode>execute</mode>
                    </slot>
                    <slot>
                        <code>0</code>
                        <mode>setchange</mode>
                    </slot>
                </slots>
            </button>
        </set>
    </sets>
</gamecontroller>
